{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "scrape": "tsx --env-file-if-exists=.env.local scripts/scrape.ts",
    "scrape:check": "tsx --env-file-if-exists=.env.local scripts/check-scrape.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
