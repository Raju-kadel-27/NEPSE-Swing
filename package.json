    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
