    "db:up": "docker compose up -d --wait db",
    "db:studio": "drizzle-kit studio",
    "backfill": "tsx --env-file-if-exists=.env.local scripts/backfill.ts",
    "backtest": "tsx --env-file-if-exists=.env.local scripts/backtest.ts",
    "train": "tsx scripts/train.ts"
